# Names only — never commit values. Real values live in GitHub Actions secrets.

# ── hunt engine (scripts/hunt-engine) ─────────────────────────────────────────
# live (default) searches the official eBay Browse API and fails closed without
# credentials; fixture reads fixtures/hunt-engine/*.json and is refused in CI.
STARLING_DATA_MODE=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production | sandbox (sandbox proves plumbing only, not inventory coverage)
EBAY_ENV=
EBAY_MARKETPLACE_ID=
STARLING_STALE_AFTER_MINUTES=
# optional outbound alert webhook; unset = the pending queue at /api/v1/alerts is the channel
STARLING_ALERT_WEBHOOK_URL=
# local only: persist to a directory instead of R2 (ignored in CI)
STARLING_HUNT_STORE_DIR=
# optional overrides for evidence storage (defaults: CLOUDFLARE_API_TOKEN, bucket starling-data)
STARLING_R2_TOKEN=
STARLING_R2_BUCKET=

# ── shared with the deal board ────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STARLING_BUYER_ZIP=
STARLING_MODE=
STARLING_BOOK=
EPN_CAMPAIGN_ID=
PSA_API_TOKEN=
LECTR_R2_TOKEN=
LECTR_R2_ACCOUNT_ID=
LECTR_R2_BUCKET=
LECTR_R2_BOOK_KEY=
