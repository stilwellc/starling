{
  "name": "starling",
  "version": "0.1.0",
  "private": true,
  "description": "Starling — a public deal board that points lectr's certified price knowledge at eBay Buy It Now. Powered by lectr (lectr.bid).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "board": "tsx scripts/run-board.ts",
    "board:fixture": "STARLING_MODE=fixture tsx scripts/run-board.ts",
    "test:matchers": "tsx scripts/match/test-matchers.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
